# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.
# On Render/Railway/Fly etc., set these in the platform's
# environment-variable / secret UI instead of using a file.

# OpenAI (used by question generation, concept extraction, pre-learning)
OPENAI_API_KEY=

# Mathpix (used by PDF/image -> MMD conversion)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Live mode is ON by default when the keys above are set.
# Dry/stub generation is disabled in production — set AEGIS_ALLOW_DRY=1 only for
# local testing without API keys (never in production).
# AEGIS_ALLOW_DRY=0

# Force dry mode even when keys are present (tests/CI only):
# AEGIS_USE_LIVE=0

# Optional: OpenAI model slug. This is the single source of truth for the model
# — the web app, the semantic resolver, and the offline aegis_pipeline CLI tools
# all read it.
# AEGIS_OPENAI_MODEL=gpt-5.6-luna

# Reasoning effort is not configurable: every request asks for "max", the
# deepest deliberation the model will give. If a deployment's endpoint does not
# accept that value it answers with a 400, and Aegis negotiates down one rung at
# a time until the request is accepted. The accepted ceiling is then cached per
# model for the life of the process, so the discovery costs one request rather
# than one per call, and a single "reasoning effort negotiated" line appears in
# the run log. Expect that line on a deployment whose ceiling is below max.

# Provider-capacity mode is ON by default. For GPT-5.6 Luna this enforces a
# 1,050,000-token context ceiling and at most 128,000 completion tokens per live
# request. Smaller purpose-specific output budgets and bounded semantic evidence
# packets remain active; larger source material is losslessly batched. Set this
# to 0 only for compatibility testing against a third-party OpenAI-compatible
# endpoint with different limits.
# AEGIS_OPENAI_PROVIDER_MAX_TOKENS=1

# These overrides are consulted only when provider-capacity mode is disabled.
# Values above the known provider capacity are always clamped safely.
# AEGIS_OPENAI_CONTEXT_WINDOW_TOKENS=1050000
# AEGIS_OPENAI_MAX_OUTPUT_TOKENS=128000

# Optional lossless MMD packet boundary. The 24,000-character default keeps
# extraction section-focused; every chunk is merged, so changing the packet size
# does not remove source characters.
# AEGIS_MMD_CHUNK_CHARS=24000

# Agent-first semantic discrepancy handling is ON when live OpenAI generation
# is available. Aegis saves the checkpoint before one bounded strict-schema
# review and applies only a high-confidence offered action/target. A request
# with an unknown outcome is never replayed automatically.
# AEGIS_AUTONOMOUS_RESOLUTION_ENABLED=1
# Maximum distinct semantic scopes that may receive an autonomous review in one
# upload. Escalated/unavailable reviews count too. This is a safety/cost ceiling,
# not a retry count; each distinct issue gets at most one call.
# AEGIS_AUTONOMOUS_RESOLUTION_MAX_DECISIONS=6
# Maximum issue-local MMD evidence characters supplied to each review.
# AEGIS_AUTONOMOUS_RESOLUTION_SOURCE_CHARS=16000
# The semantic resolver uses AEGIS_OPENAI_MODEL like the rest of the pipeline.
# Set this only to point the resolver alone at a different model; if that model
# is unavailable, the resolver falls back once to AEGIS_OPENAI_MODEL. Prices for
# an overridden model must exist in the cost table or the run reports its cost
# as incomplete.
# AEGIS_AUTONOMOUS_RESOLUTION_MODEL=gpt-5.6-luna
# Generation never pauses for a person, in any configuration. A semantic
# decision is resolved autonomously, continued with the safest offered action,
# or the run ends with the reason recorded -- a stalled job holds its worker
# with nobody watching, which is worse than a failure that says why. Corrections
# happen after the run: download the workbook and describe what to change.
#
# Automatic continuation (default ON): when a bounded review escalates or a
# safety cap fires, Aegis applies only an explicit keep/no-change route, an
# independently certified recommendation, or a source-preserving create_new
# route for a Type-host conflict. It never selects the first plausible host.
# Source replacement and custom instructions cannot be automated at all. Set 0
# to disable this continuation; the run then ends at such a decision instead of
# continuing. It does not bring back a pause.
# AEGIS_UNATTENDED_COMPLETION=1
# Maximum autonomous repairs for one materially equivalent decision. Every
# allowed repair receives a verification rerun; unrelated decisions have
# independent budgets. The legacy AEGIS_MAX_RESOLUTION_CYCLES is still read as
# a fallback during migration.
# AEGIS_MAX_EQUIVALENT_RESOLUTION_ATTEMPTS=12
# Total bounded semantic repair attempts per run (issue-scoped; identical
# candidates never retry). Clamped to 1..8.
# AEGIS_SEMANTIC_RECOVERY_MAX_TOTAL_ATTEMPTS=3

# Phase 3.8 topology/grounding convergence. The attempt budget is persisted per
# upload job and accumulates across semantic-decision pauses and worker restarts,
# so it is actually consumed instead of restarting each cycle.
# AEGIS_PHASE38_TOPOLOGY_CONVERGENCE_PASSES=6
# Bound materially different candidates for one grounding issue. When either
# this or the ordinary pass budget is spent, Aegis gets one final atomisation /
# minimal-source-concept verification pass. A second failure stops explicitly;
# no concept is retired or deleted to manufacture an output.
# AEGIS_PHASE38_MAX_CANDIDATES_PER_ISSUE=8
# Bounded, relevance-ranked window of blocks from earlier topics a later topic
# builds on, offered to exact grounding as labelled prerequisite context.
# Textbooks are cumulative, so a later section legitimately applies a
# definition several sections back, which the adjacent-only window cannot
# reach. A concept's principal claim must still ground in its own topic's
# blocks, so this cannot excuse a misplaced concept. 0 disables it.
# AEGIS_PHASE38_PREREQUISITE_BLOCKS=12

# Password for the Admin tab and destructive database reset. Google mode
# refuses to start with "admin" or a value shorter than 16 characters.
# AEGIS_ADMIN_PASSWORD=replace-with-a-long-random-secret

# Authentication. Local mode keeps development usable without an internet
# connection. Hosted deployments should set AEGIS_AUTH_MODE=google.
AEGIS_AUTH_MODE=local
# AEGIS_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
AEGIS_ALLOWED_GOOGLE_DOMAIN=up.school
# Optional one-time upgrade bridge: only this exact verified domain user may
# adopt upload jobs created before authentication was added. Leave blank by
# default; remove it after the first successful login has claimed legacy jobs.
# AEGIS_LEGACY_OWNER_EMAIL=owner@up.school
# Generate a unique, random value of at least 32 characters for hosted use.
# AEGIS_SESSION_SECRET=
# Cookies are Secure automatically in Google mode. Set this to 0 only for
# explicit localhost Google-mode testing over plain HTTP.
# AEGIS_SECURE_COOKIES=0
# Optional comma-separated cross-origin frontend origins. Same-origin
# production deployments do not need this.
# AEGIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: where the backend stores Bulk Import workbooks
# AEGIS_DATA_DIR=/app/data
# Shared cap for source, replacement, workbook, and combined syllabus uploads.
# AEGIS_MAX_UPLOAD_BYTES=134217728

# Keep SQLite beside other runtime data when that directory is a persistent
# Docker/Fly mount. Four slashes represent the absolute path /app/data/aegis.db.
# AEGIS_DB_URL=sqlite:////app/data/aegis.db

# Optional automatic Google Drive checkpoint mirror. Aegis continues using its
# local/Fly database if Drive is disabled or temporarily unavailable. Plain
# service-account mode requires a folder inside a Google Shared Drive; service
# accounts cannot own files in My Drive. Add the service account to that Shared
# Drive, then configure the folder ID and credentials.
# AEGIS_DRIVE_CHECKPOINT_BACKUP_ENABLED=0
# AEGIS_DRIVE_CHECKPOINT_FOLDER_ID=
# Prefer base64 on PowerShell/Fly so multiline JSON is preserved safely.
# AEGIS_DRIVE_SERVICE_ACCOUNT_JSON_B64=
# Advanced alternative for Workspace admins: authorize domain-wide delegation
# and impersonate a dedicated human backup account.
# AEGIS_DRIVE_IMPERSONATE_USER=
# AEGIS_DRIVE_CHECKPOINT_NAMESPACE=projectaegis
